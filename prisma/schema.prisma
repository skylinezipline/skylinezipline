// Zipline OS — Prisma Schema
// Database: PostgreSQL (Supabase / Neon recommended for Vercel)
// Run: npx prisma db push && npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(GUIDE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  staffProfile StaffMember?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  MANAGER
  GUIDE
  DISPATCH
}

// ─────────────────────────────────────────────
// BOOKINGS & GUESTS
// ─────────────────────────────────────────────

model Booking {
  id              String        @id @default(cuid())
  confirmationNum String        @unique @default(cuid())
  status          BookingStatus @default(PENDING)
  tourType        TourType
  date            DateTime
  timeSlot        String        // e.g. "09:00", "11:00", "13:00"
  guestCount      Int
  totalPrice      Decimal       @db.Decimal(10, 2)
  depositPaid     Decimal       @db.Decimal(10, 2) @default(0)
  notes           String?
  source          String?       // "website", "phone", "walk-in", "partner"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  guests          Guest[]
  checkIn         CheckIn?
  assignedGuides  StaffAssignment[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TourType {
  INTRO              // Single line intro experience
  CLASSIC            // 5-line classic tour
  ADVENTURE          // 7-line full adventure
  NIGHT_RIDE         // Evening/night tour
  PRIVATE            // Private group booking
  CORPORATE          // Corporate team-building
}

model Guest {
  id          String   @id @default(cuid())
  bookingId   String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  dob         DateTime?
  weight      Float?   // lbs — required for safety harness fitting
  height      Float?   // inches
  experience  String?
  notes       String?
  waiverSigned Boolean @default(false)
  waiverSignedAt DateTime?
  waiverVersion  String?
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// CHECK-IN
// ─────────────────────────────────────────────

model CheckIn {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  arrivedAt     DateTime  @default(now())
  allWaiversSigned Boolean @default(false)
  harnessChecked   Boolean @default(false)
  briefingComplete Boolean @default(false)
  briefingGuide    String?
  departedAt    DateTime?
  returnedAt    DateTime?
  notes         String?

  booking       Booking   @relation(fields: [bookingId], references: [id])
}

// ─────────────────────────────────────────────
// STAFF
// ─────────────────────────────────────────────

model StaffMember {
  id             String       @id @default(cuid())
  userId         String?      @unique
  firstName      String
  lastName       String
  email          String       @unique
  phone          String?
  role           StaffRole
  status         StaffStatus  @default(ACTIVE)
  hireDate       DateTime
  certifications Certification[]
  schedules      Schedule[]
  assignments    StaffAssignment[]
  incidentReports IncidentReport[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User?        @relation(fields: [userId], references: [id])
}

enum StaffRole {
  HEAD_GUIDE
  SENIOR_GUIDE
  GUIDE
  TRAINEE
  DISPATCH
  MANAGER
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

model Certification {
  id          String      @id @default(cuid())
  staffId     String
  name        String      // e.g. "ACCT Level 2", "CPR/AED", "First Aid", "Swift Water"
  issuedBy    String?
  issuedAt    DateTime
  expiresAt   DateTime?
  verified    Boolean     @default(false)
  documentUrl String?
  createdAt   DateTime    @default(now())

  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Schedule {
  id        String       @id @default(cuid())
  staffId   String
  date      DateTime
  startTime String       // "08:00"
  endTime   String       // "17:00"
  role      String?      // e.g. "Lead Guide", "Dispatch", "Platform"
  notes     String?
  status    ShiftStatus  @default(SCHEDULED)

  staff     StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

enum ShiftStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CALLED_OFF
  NO_SHOW
}

model StaffAssignment {
  id        String      @id @default(cuid())
  bookingId String
  staffId   String
  role      String      // "Lead Guide", "Tail Guide", etc.

  booking   Booking     @relation(fields: [bookingId], references: [id])
  staff     StaffMember @relation(fields: [staffId], references: [id])

  @@unique([bookingId, staffId])
}

// ─────────────────────────────────────────────
// EQUIPMENT
// ─────────────────────────────────────────────

model Equipment {
  id             String          @id @default(cuid())
  name           String
  category       EquipmentCategory
  serialNumber   String          @unique
  manufacturer   String?
  model          String?
  purchaseDate   DateTime?
  purchasePrice  Decimal?        @db.Decimal(10, 2)
  retireDate     DateTime?
  status         EquipmentStatus @default(IN_SERVICE)
  location       String?         // Platform/station where gear lives
  notes          String?
  inspections    Inspection[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

enum EquipmentCategory {
  HARNESS
  HELMET
  TROLLEY
  CARABINER
  BRAKE_SYSTEM
  CABLE
  ANCHOR
  GLOVES
  COMMUNICATION
  RESCUE_GEAR
  OTHER
}

enum EquipmentStatus {
  IN_SERVICE
  OUT_OF_SERVICE
  UNDER_INSPECTION
  RETIRED
  LOST
}

model Inspection {
  id          String           @id @default(cuid())
  equipmentId String
  inspectedBy String           // Staff name
  type        InspectionType
  status      InspectionStatus
  date        DateTime         @default(now())
  nextDue     DateTime?
  findings    String?
  passed      Boolean
  createdAt   DateTime         @default(now())

  equipment   Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

enum InspectionType {
  DAILY_PRE_OPERATION
  WEEKLY
  MONTHLY
  ANNUAL
  POST_INCIDENT
  MANUFACTURER_SERVICE
}

enum InspectionStatus {
  PASSED
  PASSED_WITH_NOTES
  FAILED
  REQUIRES_SERVICE
}

// ─────────────────────────────────────────────
// SAFETY & INCIDENTS
// ─────────────────────────────────────────────

model IncidentReport {
  id            String          @id @default(cuid())
  incidentNumber String         @unique @default(cuid())
  date          DateTime
  location      String          // Platform/cable/station
  type          IncidentType
  severity      Severity
  description   String          @db.Text
  injuredParty  String?         // Guest name or staff name
  witnessNames  String[]
  actionsTaken  String          @db.Text
  reportedById  String
  status        ReportStatus    @default(OPEN)
  closedAt      DateTime?
  followUpNotes String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  reportedBy    StaffMember     @relation(fields: [reportedById], references: [id])
}

enum IncidentType {
  NEAR_MISS
  GUEST_INJURY
  STAFF_INJURY
  EQUIPMENT_FAILURE
  WEATHER_EVENT
  PROPERTY_DAMAGE
  OTHER
}

enum Severity {
  LOW       // Minor, no injury
  MEDIUM    // Minor injury, first aid required
  HIGH      // Significant injury, medical attention needed
  CRITICAL  // Serious injury, emergency response activated
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

// ─────────────────────────────────────────────
// OPERATIONS SETTINGS
// ─────────────────────────────────────────────

model OperatingDay {
  id          String   @id @default(cuid())
  date        DateTime @unique
  isOpen      Boolean  @default(true)
  openTime    String   @default("09:00")
  closeTime   String   @default("17:00")
  maxCapacity Int      @default(48)
  notes       String?
  weatherHold Boolean  @default(false)
  weatherNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TimeSlot {
  id         String   @id @default(cuid())
  time       String   // "09:00"
  capacity   Int      @default(8)
  isActive   Boolean  @default(true)
  tourTypes  String[] // Which tour types use this slot
}
